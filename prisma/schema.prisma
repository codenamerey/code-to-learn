generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())

  @@map("categories")
}

model Course {
  id                Int       @id @default(autoincrement())
  title             String
  slug              String    @unique
  author            String
  description       String
  learnCount        Int       @default(0)
  lessonCount       Int
  includeVisualizer Boolean   @default(false)
  categoryId        Int
  category          Category  @relation(fields: [categoryId], references: [id])
  lessons           Lesson[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("courses")
}

model Lesson {
  id            Int           @id @default(autoincrement())
  index         Int
  title         String
  courseId      Int
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonContent LessonContent?
  createdAt     DateTime      @default(now())

  @@unique([courseId, index])
  @@map("lessons")
}

model LessonContent {
  id                Int    @id @default(autoincrement())
  lessonId          Int    @unique
  lesson            Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonText        String
  defaultCode       String
  abstractedCode    String
  testRunner        String
  demoData          String @default("")
  documentationData Json
  hintsData         Json
  visualizerConfig  Json?

  @@map("lesson_contents")
}