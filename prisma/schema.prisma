generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id()
  email         String?        @unique
  name          String?
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  courseProgress CourseProgress[]
  bookmarkedCourses CourseBookmark[]

  @@map("users")
}

model CourseProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId   Int?
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("course_progress")
}

model CourseBookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@map("course_bookmarks")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())

  @@map("categories")
}

model Course {
  id                Int       @id @default(autoincrement())
  title             String
  slug              String    @unique
  author            String
  description       String
  learnCount        Int       @default(0)
  lessonCount       Int
  includeVisualizer Boolean   @default(false)
  categoryId        Int
  category          Category  @relation(fields: [categoryId], references: [id])
  lessons           Lesson[]
  progress          CourseProgress[]
  bookmarks         CourseBookmark[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("courses")
}

model Lesson {
  id            Int           @id @default(autoincrement())
  index         Int
  title         String
  courseId      Int
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonContent LessonContent?
  progress      CourseProgress[]
  createdAt     DateTime      @default(now())

  @@unique([courseId, index])
  @@map("lessons")
}

model LessonContent {
  id                Int    @id @default(autoincrement())
  lessonId          Int    @unique
  lesson            Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonText        String
  defaultCode       String
  abstractedCode    String
  testRunner        String
  demoData          String @default("")
  documentationData Json
  hintsData         Json
  visualizerConfig  Json?

  @@map("lesson_contents")
}