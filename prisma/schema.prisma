generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id()
  email         String?        @unique
  name          String?
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  courseProgress CourseProgress[]
  bookmarkedCourses CourseBookmark[]
  sublessonProgress SublessonProgress[]

  @@map("users")
}

model CourseProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId   Int
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed  Boolean  @default(false)
  solution   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, lessonId])
  @@map("course_progress")
}

model CourseBookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@map("course_bookmarks")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())

  @@map("categories")
}

model Course {
  id                Int       @id @default(autoincrement())
  title             String
  slug              String    @unique
  author            String
  description       String
  learnCount        Int       @default(0)
  lessonCount       Int
  includeVisualizer Boolean   @default(false)
  status            String    @default("published")
  createdBy         String?
  updatedBy         String?
  categoryId        Int
  category          Category  @relation(fields: [categoryId], references: [id])
  lessons           Lesson[]
  bookmarks         CourseBookmark[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("courses")
}

model Lesson {
  id            Int           @id @default(autoincrement())
  index         Int
  title         String
  status        String        @default("published")
  createdBy     String?
  updatedBy     String?
  courseId      Int
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonType    String        @default("code")
  lessonContent LessonContent?
  sublessons    Sublesson[]
  progress      CourseProgress[]
  
  // Exercise relationships
  quizzes       Quiz[]
  codeChallenge CodeChallenge[]
  fillInBlanks  FillInBlank[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([courseId, index])
  @@map("lessons")
}

model LessonContent {
  id                Int    @id @default(autoincrement())
  lessonId          Int    @unique
  lesson            Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonText        String
  defaultCode       Json   @default("{}")
  abstractedCode    Json   @default("{}")
  testRunner        Json   @default("{}")
  demoData          Json   @default("{}")
  documentationData Json   @default("[]")
  hintsData         Json   @default("[]")
  visualizerConfig  Json?
  quizData          Json?

  @@map("lesson_contents")
}

model Sublesson {
  id              Int              @id @default(autoincrement())
  index           Int
  title           String
  videoUrl        String?
  videoStart      Int              @default(0)
  videoEnd        Int?
  lessonType      String           @default("quiz")
  status          String           @default("published")
  createdBy       String?
  updatedBy       String?
  lessonId        Int
  lesson          Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sublessonContent SublessonContent?
  progress        SublessonProgress[]
  
  // Exercise relationships
  quizzes         Quiz[]
  codeChallenge   CodeChallenge[]
  fillInBlanks    FillInBlank[]
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([lessonId, index])
  @@map("sublessons")
}

model SublessonContent {
  id                Int       @id @default(autoincrement())
  sublessonId       Int       @unique
  sublesson         Sublesson @relation(fields: [sublessonId], references: [id], onDelete: Cascade)
  lessonText        String
  defaultCode       Json      @default("{}")
  abstractedCode    Json      @default("{}")
  testRunner        Json      @default("{}")
  demoData          Json      @default("{}")
  documentationData Json      @default("[]")
  hintsData         Json      @default("[]")
  visualizerConfig  Json?
  quizData          Json?

  @@map("sublesson_contents")
}

model SublessonProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sublessonId Int
  sublesson  Sublesson @relation(fields: [sublessonId], references: [id], onDelete: Cascade)
  completed  Boolean  @default(false)
  solution   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, sublessonId])
  @@map("sublesson_progress")
}

model Quiz {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  passingScore Int      @default(70)
  timeLimit   Int?      // in minutes
  showExplanations Boolean @default(true)
  index       Int       @default(0)
  
  // Foreign key relationships
  lessonId    Int?
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sublessonId Int?
  sublesson   Sublesson? @relation(fields: [sublessonId], references: [id], onDelete: Cascade)
  
  questions   QuizQuestion[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("quizzes")
}

model QuizQuestion {
  id            Int      @id @default(autoincrement())
  quizId        Int
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  type          String   @default("multiple_choice") // multiple_choice, true_false, fill_blank
  options       Json?    // Array of options for multiple choice
  correctAnswer String
  explanation   String?
  index         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("quiz_questions")
}

model CodeChallenge {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  difficulty  String    @default("easy") // easy, medium, hard
  starterCode Json      @default("{}") // language -> code mapping
  solution    Json      @default("{}") // language -> solution mapping
  tests       Json      @default("{}") // language -> test code mapping
  hints       Json      @default("[]") // Array of hint strings
  index       Int       @default(0)
  
  // Foreign key relationships  
  lessonId    Int?
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sublessonId Int?
  sublesson   Sublesson? @relation(fields: [sublessonId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("code_challenges")
}

model FillInBlank {
  id          Int       @id @default(autoincrement())
  title       String
  text        String    // Text with ___BLANK_1___ placeholders
  explanation String?
  index       Int       @default(0)
  
  // Foreign key relationships
  lessonId    Int?
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sublessonId Int?
  sublesson   Sublesson? @relation(fields: [sublessonId], references: [id], onDelete: Cascade)
  
  blanks      FillInBlankAnswer[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("fill_in_blanks")
}

model FillInBlankAnswer {
  id              Int         @id @default(autoincrement())
  fillInBlankId   Int
  fillInBlank     FillInBlank @relation(fields: [fillInBlankId], references: [id], onDelete: Cascade)
  blankId         String      // BLANK_1, BLANK_2, etc.
  correctAnswer   String
  alternatives    Json        @default("[]") // Array of alternative correct answers
  caseSensitive   Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("fill_in_blank_answers")
}