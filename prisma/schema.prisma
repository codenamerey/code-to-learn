generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id()
  email         String?        @unique
  name          String?
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  courseProgress CourseProgress[]
  bookmarkedCourses CourseBookmark[]
  sublessonProgress SublessonProgress[]

  @@map("users")
}

model CourseProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId   Int
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed  Boolean  @default(false)
  solution   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, lessonId])
  @@map("course_progress")
}

model CourseBookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@map("course_bookmarks")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())

  @@map("categories")
}

model Course {
  id                Int       @id @default(autoincrement())
  title             String
  slug              String    @unique
  author            String
  description       String
  learnCount        Int       @default(0)
  lessonCount       Int
  includeVisualizer Boolean   @default(false)
  categoryId        Int
  category          Category  @relation(fields: [categoryId], references: [id])
  lessons           Lesson[]
  bookmarks         CourseBookmark[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("courses")
}

model Lesson {
  id            Int           @id @default(autoincrement())
  index         Int
  title         String
  courseId      Int
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonType    String        @default("code")
  lessonContent LessonContent?
  sublessons    Sublesson[]
  progress      CourseProgress[]
  createdAt     DateTime      @default(now())

  @@unique([courseId, index])
  @@map("lessons")
}

model LessonContent {
  id                Int    @id @default(autoincrement())
  lessonId          Int    @unique
  lesson            Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonText        String
  defaultCode       String @default("")
  abstractedCode    String @default("")
  testRunner        String @default("")
  demoData          String @default("")
  documentationData Json   @default("[]")
  hintsData         Json   @default("[]")
  visualizerConfig  Json?
  quizData          Json?

  @@map("lesson_contents")
}

model Sublesson {
  id              Int              @id @default(autoincrement())
  index           Int
  title           String
  videoUrl        String?
  videoStart      Int              @default(0)
  videoEnd        Int?
  lessonType      String           @default("quiz")
  lessonId        Int
  lesson          Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sublessonContent SublessonContent?
  progress        SublessonProgress[]
  createdAt       DateTime         @default(now())

  @@unique([lessonId, index])
  @@map("sublessons")
}

model SublessonContent {
  id                Int       @id @default(autoincrement())
  sublessonId       Int       @unique
  sublesson         Sublesson @relation(fields: [sublessonId], references: [id], onDelete: Cascade)
  lessonText        String
  defaultCode       String    @default("")
  abstractedCode    String    @default("")
  testRunner        String    @default("")
  demoData          String    @default("")
  documentationData Json      @default("[]")
  hintsData         Json      @default("[]")
  visualizerConfig  Json?
  quizData          Json?

  @@map("sublesson_contents")
}

model SublessonProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sublessonId Int
  sublesson  Sublesson @relation(fields: [sublessonId], references: [id], onDelete: Cascade)
  completed  Boolean  @default(false)
  solution   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, sublessonId])
  @@map("sublesson_progress")
}